# Python backend — copy to .env and fill in your values
# Email notification (optional — system prints [SIMULATED EMAIL SENT] if unset)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_app_password
ALERT_RECIPIENT=recipient@example.com

# Base URL used to build image_url links stored in the database.
# For local development leave as-is. Change for remote/hosted deployments.
BACKEND_PUBLIC_BASE_URL=http://127.0.0.1:8000
